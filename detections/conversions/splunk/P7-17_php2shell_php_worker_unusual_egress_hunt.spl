Image IN ("*/php-fpm*", "*/php-cgi*", "*/lsphp*", "*/frankenphp*", "*/apache2*", "*/httpd*") Initiated="true" NOT (DestinationIp="10.0.0.0/8" OR DestinationIp="172.16.0.0/12" OR DestinationIp="192.168.0.0/16" OR DestinationIp="127.0.0.0/8" OR DestinationIp="169.254.0.0/16" OR DestinationIp="::1/128" OR DestinationIp="fc00::/7" OR DestinationIp="fe80::/10" OR DestinationPort IN (25, 53, 80, 443, 465, 587, 3306, 5432, 6379, 11211))
